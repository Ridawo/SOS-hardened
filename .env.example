=====================================================
Variables OAuth2 / API por integrante
=====================================================
Copiar a .env y rellenar con valores reales.
NO subir .env al repo.
=====================================================
----------------------------
Auth (JWT + login) — añadido en la mitigación de PAI-3
----------------------------
# Genera un valor aleatorio, no escribas nada a mano aquí:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_USER=
# Genera una contraseña aleatoria, no uses algo adivinable:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_PASSWORD=

----------------------------
JFM - Mastodon + Copernicus ESA + FedEx Sandbox (OAuth2 client_credentials)
----------------------------
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_INSTANCE=

COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=

----------------------------
MRG - Vimeo + Dailymotion + Discord (OAuth2 client_credentials)
----------------------------
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

DAILYMOTION_CLIENT_ID=
DAILYMOTION_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

----------------------------
TGG - NewsAPI + Spotify + Github (OAuth2 client_credentials)
----------------------------
NEWSAPI_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
